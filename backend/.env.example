# Copie este arquivo para .env e preencha os valores.

# MQTT (Mosquitto local)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=casa/temperatura

# InfluxDB 2.x (valores definidos na configuração inicial do InfluxDB)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=casa
INFLUX_BUCKET=iot

# API
API_PORT=8000
